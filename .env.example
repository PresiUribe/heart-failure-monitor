# Copiar a .env. Nunca subir .env al repositorio.
DATABASE_PROVIDER=Docker PostgreSQL
DATABASE_URL=postgresql://app_admin:app_password@app-db:5432/heart_failure
APP_POSTGRES_DB=heart_failure
APP_POSTGRES_USER=app_admin
APP_POSTGRES_PASSWORD=app_password

JWT_SECRET_KEY=REEMPLAZAR-POR-UNA-CLAVE-ALEATORIA-LARGA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://localhost
RATE_LIMIT_PER_MINUTE=600

FHIR_BASE_URL=http://hapi-fhir:8080/fhir
FHIR_TIMEOUT_SECONDS=10
FHIR_HOOK_SECRET=REEMPLAZAR-POR-SECRETO-INTERNO-FHIR
HAPI_IMAGE=hapiproject/hapi:v8.6.5-1
HAPI_POSTGRES_DB=hapi
HAPI_POSTGRES_USER=hapi_admin
HAPI_POSTGRES_PASSWORD=hapi_password

MONGO_URL=mongodb://mongo:27017
MONGO_DATABASE=heart_failure_billing
ML_BASE_URL=http://ml:8001
ORTHANC_BASE_URL=http://orthanc:8042
CRITICAL_RISK_THRESHOLD=0.70
ALERT_ESCALATION_SECONDS=120
PUBLIC_BASE_URL=