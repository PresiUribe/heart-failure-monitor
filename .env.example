# Copiar a .env. Nunca subir .env al repositorio.
DATABASE_PROVIDER=Docker PostgreSQL
DATABASE_URL=postgresql://app_admin:app_password@app-db:5432/heart_failure
DATABASE_URL_DIRECT=postgresql://app_admin:app_password@app-db:5432/heart_failure
APP_POSTGRES_DB=heart_failure
APP_POSTGRES_USER=app_admin
APP_POSTGRES_PASSWORD=app_password

JWT_SECRET_KEY=REEMPLAZAR-POR-UNA-CLAVE-ALEATORIA-LARGA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://localhost
RATE_LIMIT_PER_MINUTE=600

FHIR_BASE_URL=http://hapi-fhir:8080/fhir
FHIR_TIMEOUT_SECONDS=30
FHIR_HOOK_SECRET=REEMPLAZAR-POR-SECRETO-INTERNO-FHIR
HAPI_IMAGE=hapiproject/hapi:v8.6.5-1
HAPI_POSTGRES_DB=hapi
HAPI_POSTGRES_USER=hapi_admin
HAPI_POSTGRES_PASSWORD=hapi_password

MONGO_URL=mongodb://mongo:27017
MONGO_DATABASE=heart_failure_billing
ML_BASE_URL=http://ml:8001
ORTHANC_BASE_URL=http://orthanc:8042
CRITICAL_RISK_THRESHOLD=0.70
ALERT_ESCALATION_SECONDS=120
PUBLIC_BASE_URL=

# Opcional: token de un túnel con nombre (perfil "named" del compose)
CLOUDFLARE_TUNNEL_TOKEN=

# RAG clínico (Semana 12)
RAG_METODO=hibrido
RAG_UMBRAL_COS=0.35
RAG_UMBRAL_BM25=4.0
# LLM de Groq (RAG y agente). Sin llave: RAG extractivo y agente con modelo simulado.
# qwen/qwen3-32b fue retirado por Groq en julio de 2026; si hay límite de tasa, usar openai/gpt-oss-20b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Agente clínico (Semana 13)
AGENTE_MODELO=auto
AGENTE_MAX_SIMULTANEAS=3
AGENTE_TIMEOUT_S=90
AGENTE_MAX_LLAMADAS_MODELO=8

# Interoperabilidad entre instituciones (proyecto final)
INTEROP_NOMBRE=Heart Failure Monitor (UAO)
INTEROP_SISTEMA_BASE=https://hfmonitor.uao.edu.co/fhir
# El mismo con todos los socios (el de la clase para la demo; en producción, uno privado por canal privado)
INTEROP_SECRETO_FEDERADO=secreto-federado-del-curso-solo-demo
# Cifra en reposo los secretos de los socios. Vacío: se deriva de JWT_SECRET_KEY (si cambia esa clave, hay que recargar las credenciales).
INTEROP_CLAVE_CIFRADO=

# Seguridad (proyecto final). Genere cada una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# R27: cifra documento, teléfono, dirección y vereda de los pacientes (AES-256-GCM). NO la cambie después de
# cargar datos: lo cifrado con la anterior no se podría leer. Vacía: se deriva de JWT_SECRET_KEY.
CAMPOS_CLAVE=
# R28: llave de la cadena de hashes de la auditoría (HMAC). Vacía: se deriva de JWT_SECRET_KEY.
AUDITORIA_CLAVE=
